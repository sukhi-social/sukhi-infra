{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["quadlet", "github-actions"],
  "pinDigests": true,
  "automerge": false,
  "packageRules": [
    {
      "description": "sukhi の image は sha-タグで順序が無い。sukhi-fedi の CI が 4 つ同時に bump する(docs: OPS_QUADLET_GITOPS.md §5)",
      "matchPackageNames": ["ghcr.io/sukhi-social/**"],
      "enabled": false
    }
  ]
}
