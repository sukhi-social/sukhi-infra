# SPDX-License-Identifier: AGPL-3.0-or-later
[Unit]
Description=sukhi Anubis
After=sukhi-gateway.service

[Container]
ContainerName=sukhi-anubis
Image=ghcr.io/sukhi-social/sukhi-fedi-anubis:{{version}}@{{digest:anubis}}
Network=sukhi.network
# コマンド引数として直接渡す
Exec=-bind :8080 -target http://sukhi-gateway:4000 -difficulty 4 -serve-robots-txt=true -cookie-partitioned=true
# 秘密鍵は podman secret から環境変数に注入
Secret=anubis_ed25519_key,type=env,target=ED25519_PRIVATE_KEY_HEX
PublishPort=127.0.0.1:8181:8080
Label=app=sukhi
DropCapability=ALL
NoNewPrivileges=true

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
