# SPDX-License-Identifier: AGPL-3.0-or-later
[Unit]
Description=sukhi gateway (combined)
Requires=sukhi-nats.service sukhi-rustfs.service
After=sukhi-nats.service sukhi-rustfs.service

[Container]
ContainerName=sukhi-gateway
# image の版とダイジェストは箱の同期スクリプト(sukhi-render)が overlays/<env>/sukhi.version で埋める。
Image=ghcr.io/sukhi-social/sukhi-fedi-combined:{{version}}@{{digest:combined}}
Network=sukhi.network
# データ(/var/lib/sukhi)の mount は overlay が決める(dev は named volume、prod は箱の bind)。
Environment=SUKHI_STORE=datalevin
Environment=DATALEVIN_DIR=/var/lib/sukhi/datalevin
Environment=SUKHI_QUEUE_DB=/var/lib/sukhi/queue.db
Environment=DELIVERY_QUEUE_DB=/var/lib/sukhi/delivery_queue.db
Environment=SUKHI_GRAPH=1
# 翻訳の訳し役(docs/TRANSLATION.md)。sukhi-translate は base の sukhi-translate.container。落ちていても gateway は動く(翻訳だけ失敗する)。
Environment=LIBRETRANSLATE_URL=http://sukhi-translate:5000
# gateway は NATS_HOST / NATS_PORT を読む(NATS_URL は bun の sidecar だけが読む)。
Environment=NATS_HOST=sukhi-nats
Environment=NATS_PORT=4222
# The environment overlay supplies /etc/sukhi/instance.json. Keep it read-only.
# 同期が quadlet dir に写す instance.json(通常ファイル)を mount する。/etc の symlink を mount すると、:z は link にしか効かず読めない(SELinux)。
Volume=%h/.config/containers/systemd/instance.json:/etc/sukhi/instance.json:ro,z
Environment=SUKHI_INSTANCE_CONFIG=/etc/sukhi/instance.json
# `/` は既定だと nodeinfo_monitor アドオン(NodeInfo viewer)が答え、web-next に渡らない。
# SNS として使うので切る(viewer とウォッチャー bot の登録は 404 になる)。
Environment=DISABLE_ADDONS=nodeinfo_monitor
# DOMAIN などの環境ごとの値は overlays/<env>/ に置く。
# 秘密は事前に podman secret で作る(sukhi-setup の docs/PREPARE.md)。
# 秘密は /run/secrets/<名前> に現れ、entrypoint がファイル名と同じ変数に入れる。
Secret=erlang_cookie,type=mount,target=ERLANG_COOKIE
Secret=secret_key_base,type=mount,target=SECRET_KEY_BASE
Secret=s3_access_key_id,type=mount,target=S3_ACCESS_KEY_ID
Secret=s3_secret_access_key,type=mount,target=S3_SECRET_ACCESS_KEY
Secret=smtp_username,type=mount,target=SMTP_USERNAME
Secret=smtp_password,type=mount,target=SMTP_PASSWORD
Secret=vapid_private_key,type=mount,target=VAPID_PRIVATE_KEY
Secret=vapid_subject,type=mount,target=VAPID_SUBJECT
Label=app=sukhi
DropCapability=ALL
NoNewPrivileges=true
# image に curl は無い。Alpine の busybox wget を使う。
HealthCmd=wget -q -O /dev/null http://127.0.0.1:4000/up
HealthInterval=15s
HealthTimeout=3s
HealthRetries=3
HealthStartPeriod=90s
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=180

[Install]
WantedBy=default.target
