# SPDX-License-Identifier: AGPL-3.0-or-later
[Unit]
Description=sukhi web-next
After=sukhi-gateway.service

[Container]
ContainerName=sukhi-web-next
Image=ghcr.io/sukhi-social/sukhi-fedi-web-next:{{version}}@{{digest:web-next}}
Network=sukhi.network
Volume=sukhi-web-data.volume:/app/data:Z
Environment=GATEWAY_URL=http://sukhi-gateway:4000
Environment=COOKIE_SECURE=1
Label=app=sukhi
DropCapability=ALL
NoNewPrivileges=true
# node:24-alpine。curl は無いので busybox wget。/.sukhi/web.json は静的で、gateway も読む。
HealthCmd=wget -q -O /dev/null http://127.0.0.1:3000/.sukhi/web.json
HealthInterval=15s
HealthTimeout=3s
HealthRetries=3
HealthStartPeriod=20s
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=90

[Install]
WantedBy=default.target
