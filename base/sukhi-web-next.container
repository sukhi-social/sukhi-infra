# SPDX-License-Identifier: AGPL-3.0-or-later
[Unit]
Description=sukhi web-next
After=sukhi-gateway.service

[Container]
ContainerName=sukhi-web-next
Image=ghcr.io/sukhi-social/sukhi-fedi-web-next:{{version}}@{{digest:web-next}}
Network=sukhi.network
# /app/data の mount は overlay が決める(dev は named volume、prod は箱の bind)。
Environment=GATEWAY_URL=http://sukhi-gateway:4000
Environment=COOKIE_SECURE=1
Label=app=sukhi
DropCapability=ALL
NoNewPrivileges=true
# node:24-alpine。curl は無いので busybox wget。web-next には /.sukhi/web.json も /up も無く 404 になる。/login が 200(箱の現行と同じ口)。
HealthCmd=wget -q -O /dev/null http://127.0.0.1:3000/login
HealthInterval=15s
HealthTimeout=3s
HealthRetries=3
HealthStartPeriod=20s
HealthOnFailure=kill
Notify=healthy
# node が PID 1 だと SIGTERM を受けず、10 秒待って SIGKILL(137)になる。init を挟んで素直に止める。
PodmanArgs=--init

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=90

[Install]
WantedBy=default.target
